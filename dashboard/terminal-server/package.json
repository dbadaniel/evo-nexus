{
  "name": "evo-terminal-server",
  "version": "0.1.0",
  "description": "Terminal bridge for the EvoNexus dashboard — spawns claude CLI sessions over HTTP/WebSocket",
  "private": true,
  "main": "src/server.js",
  "bin": {
    "evo-terminal-server": "./bin/server.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "dev": "node bin/server.js --dev",
    "build:engines": "tsc -p tsconfig.json",
    "prestart": "npm run build:engines",
    "postinstall": "node -e \"if (process.platform !== 'win32') { try { require('child_process').execSync('chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper node_modules/node-pty/prebuilds/darwin-x64/spawn-helper') } catch(e) {} }\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-pty": "^1.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "openai": "^4.28.0",
    "zod": "^3.22.4",
    "execa": "^8.0.1",
    "chalk": "^5.3.0",
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "lodash-es": "^4.17.21",
    "chokidar": "^3.6.0",
    "react": "19.2.4",
    "esbuild": "^0.20.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.20",
    "@types/react": "19.2.14",
    "@types/bun": "^1.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
